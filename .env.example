# APP_URL: The URL where this applet is hosted.
APP_URL=

# MONGODB_URI: MongoDB connection string (e.g. MongoDB Atlas URI).
# In Atlas, Network Access must allow 0.0.0.0/0 (or Railway's IPs) since
# Railway/serverless hosts don't have a fixed outbound IP.
MONGODB_URI=

# JWT_SECRET: Secret key for signing JSON Web Tokens
JWT_SECRET=

# --- Backend (Railway) ---
# CORS_ORIGINS: optional comma-separated list of frontend origins allowed to
# call this API cross-origin, e.g. https://shopstack.vercel.app,https://myshop.com
# Leave unset to allow any origin (auth uses Bearer tokens, not cookies).
# When set, *.vercel.app, *.railway.app and localhost are still allowed.
CORS_ORIGINS=

# --- Frontend (Vercel) ---
# VITE_API_URL: base URL of the Railway backend, e.g.
# https://shopstack-production.up.railway.app (a trailing /api is fine).
# This is baked in at build time: after changing it in Vercel, redeploy.
# Leave unset for local dev (frontend and backend share an origin then).
VITE_API_URL=
