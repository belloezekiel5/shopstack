# APP_URL: The URL where this applet is hosted.
APP_URL=

# MONGODB_URI: MongoDB connection string (e.g. MongoDB Atlas URI).
# In Atlas, Network Access must allow 0.0.0.0/0 (or Railway's IPs) since
# Railway/serverless hosts don't have a fixed outbound IP.
MONGODB_URI=

# JWT_SECRET: Secret key for signing JSON Web Tokens
JWT_SECRET=

# --- Backend (Railway) ---
# CORS_ORIGINS: comma-separated list of frontend origins allowed to call this
# API cross-origin, e.g. https://shopstack.vercel.app,http://localhost:5173
# Any *.vercel.app origin (preview deployments included) is allowed by default.
CORS_ORIGINS=

# --- Frontend (Vercel) ---
# VITE_API_URL: base URL of the Railway backend, e.g.
# https://shopstack-production.up.railway.app
# Leave unset for local dev (frontend and backend share an origin then).
VITE_API_URL=
